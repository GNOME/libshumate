#ifndef __SHUMATE_VERSION_H__
#define __SHUMATE_VERSION_H__

/**
 * SECTION:shumate-version
 * @short_description: Versioning utility macros
 *
 * Shumate offers a set of macros for checking the version of the library
 * an application was linked to.
 */

/* These macros are used to mark deprecated symbols in Shumate headers,
 * and thus have to be exposed in installed headers. But please
 * do *not* use them in other projects. Instead define your own wrappers
 * around it.
 */

#if !defined(SHUMATE_DISABLE_DEPRECATION_WARNINGS) && \
    (G_GNUC_CHECK_VERSION(4, 6) ||                 \
     __clang_major__ > 3 || (__clang_major__ == 3 && __clang_minor__ >= 4))
#define _SHUMATE_GNUC_DO_PRAGMA(x) _Pragma(G_STRINGIFY (x))
#define SHUMATE_DEPRECATED_MACRO _SHUMATE_GNUC_DO_PRAGMA(GCC warning "Deprecated pre-processor symbol")
#define SHUMATE_DEPRECATED_MACRO_FOR(f) \
  _SHUMATE_GNUC_DO_PRAGMA(GCC warning G_STRINGIFY (Deprecated pre-processor symbol: replace with #f))
#define SHUMATE_UNAVAILABLE_MACRO(maj,min) \
  _SHUMATE_GNUC_DO_PRAGMA(GCC warning G_STRINGIFY (Not available before maj.min))
#else
#define SHUMATE_DEPRECATED_MACRO
#define SHUMATE_DEPRECATED_MACRO_FOR(f)
#define SHUMATE_UNAVAILABLE_MACRO(maj,min)
#endif

#if !defined(SHUMATE_DISABLE_DEPRECATION_WARNINGS) && \
    (G_GNUC_CHECK_VERSION(6, 1) ||                 \
     (defined (__clang_major__) && (__clang_major__ > 3 || (__clang_major__ == 3 && __clang_minor__ >= 0))))
#define SHUMATE_DEPRECATED_ENUMERATOR G_DEPRECATED
#define SHUMATE_DEPRECATED_ENUMERATOR_FOR(f) G_DEPRECATED_FOR(f)
#define SHUMATE_UNAVAILABLE_ENUMERATOR(maj,min) G_UNAVAILABLE(maj,min)
#else
#define SHUMATE_DEPRECATED_ENUMERATOR
#define SHUMATE_DEPRECATED_ENUMERATOR_FOR(f)
#define SHUMATE_UNAVAILABLE_ENUMERATOR(maj,min)
#endif

#if !defined(SHUMATE_DISABLE_DEPRECATION_WARNINGS) && \
    (G_GNUC_CHECK_VERSION(3, 1) ||                 \
     (defined (__clang_major__) && (__clang_major__ > 3 || (__clang_major__ == 3 && __clang_minor__ >= 0))))
#define SHUMATE_DEPRECATED_TYPE G_DEPRECATED
#define SHUMATE_DEPRECATED_TYPE_FOR(f) G_DEPRECATED_FOR(f)
#define SHUMATE_UNAVAILABLE_TYPE(maj,min) G_UNAVAILABLE(maj,min)
#else
#define SHUMATE_DEPRECATED_TYPE
#define SHUMATE_DEPRECATED_TYPE_FOR(f)
#define SHUMATE_UNAVAILABLE_TYPE(maj,min)
#endif

@SHUMATE_VERSIONS@

/* evaluates to the current stable version, with a hard backstop to the
 * beginning of the stable series
 */
#if G_ENCODE_VERSION (SHUMATE_MAJOR_VERSION, SHUMATE_MINOR_VERSION) >= SHUMATE_VERSION_1_0
# define SHUMATE_VERSION_CUR_STABLE         (G_ENCODE_VERSION (SHUMATE_MAJOR_VERSION, SHUMATE_MINOR_VERSION))
#else
# define SHUMATE_VERSION_CUR_STABLE         SHUMATE_VERSION_1_0
#endif

/* evaluates to the previous stable version, with a hard backstop to the
 * beginning of the stable series
 */
#if G_ENCODE_VERSION (SHUMATE_MAJOR_VERSION, SHUMATE_MINOR_VERSION) > SHUMATE_VERSION_1_0
# define SHUMATE_VERSION_PREV_STABLE        (G_ENCODE_VERSION (SHUMATE_MAJOR_VERSION, SHUMATE_MINOR_VERSION - 1))
#else
# define SHUMATE_VERSION_PREV_STABLE        SHUMATE_VERSION_1_0
#endif

/**
 * SHUMATE_VERSION_MIN_REQUIRED:
 *
 * A macro that should be defined by the user prior to including
 * the `shumate.h` header.
 *
 * The definition should be one of the predefined Shumate version
 * macros: %SHUMATE_VERSION_1_0, %SHUMATE_VERSION_1_1,…
 *
 * This macro defines the lower bound for the Shumate API to use.
 *
 * If a function has been deprecated in a newer version of Shumate,
 * it is possible to use this symbol to avoid the compiler warnings
 * without disabling warning for every deprecated function.
 */
#ifndef SHUMATE_VERSION_MIN_REQUIRED
# define SHUMATE_VERSION_MIN_REQUIRED      (SHUMATE_VERSION_CUR_STABLE)
#endif

/**
 * SHUMATE_VERSION_MAX_ALLOWED:
 *
 * A macro that should be defined by the user prior to including
 * the `shumate.h` header.
 *
 * The definition should be one of the predefined Shumate version
 * macros: %SHUMATE_VERSION_1_0, %SHUMATE_VERSION_1_1,…
 *
 * This macro defines the upper bound for the Shumate API to use.
 *
 * If a function has been introduced in a newer version of Shumate,
 * it is possible to use this symbol to get compiler warnings when
 * trying to use that function.
 */
#ifndef SHUMATE_VERSION_MAX_ALLOWED
# if SHUMATE_VERSION_MIN_REQUIRED > SHUMATE_VERSION_PREV_STABLE
#  define SHUMATE_VERSION_MAX_ALLOWED      SHUMATE_VERSION_MIN_REQUIRED
# else
#  define SHUMATE_VERSION_MAX_ALLOWED      SHUMATE_VERSION_CUR_STABLE
# endif
#endif

/* sanity checks */
#if SHUMATE_VERSION_MAX_ALLOWED < SHUMATE_VERSION_MIN_REQUIRED
# error "SHUMATE_VERSION_MAX_ALLOWED must be >= SHUMATE_VERSION_MIN_REQUIRED"
#endif
#if SHUMATE_VERSION_MIN_REQUIRED < SHUMATE_VERSION_1_0
# error "SHUMATE_VERSION_MIN_REQUIRED must be >= SHUMATE_VERSION_1_0"
#endif

/**
 * SHUMATE_CHECK_VERSION:
 * @major: major version (e.g. 1 for version 1.2.5)
 * @minor: minor version (e.g. 2 for version 1.2.5)
 * @micro: micro version (e.g. 5 for version 1.2.5)
 *
 * Returns %TRUE if the version of the Shumate header files
 * is the same as or newer than the passed-in version.
 *
 * Returns: %TRUE if Shumate headers are new enough
 */
#define SHUMATE_CHECK_VERSION(major,minor,micro)                              \
    (SHUMATE_MAJOR_VERSION > (major) ||                                       \
     (SHUMATE_MAJOR_VERSION == (major) && SHUMATE_MINOR_VERSION > (minor)) || \
     (SHUMATE_MAJOR_VERSION == (major) && SHUMATE_MINOR_VERSION == (minor) && \
      SHUMATE_MICRO_VERSION >= (micro)))

@SHUMATE_VISIBILITY@

#endif /* __SHUMATE_VERSION_H__ */
